<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/examHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/webViewProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="#D4AF37"
            app:trackColor="@android:color/transparent"
            android:elevation="10dp" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            layout="@layout/custom_keyboard"
            android:visibility="gone" />

        <include
            layout="@layout/layout_offline"
            android:visibility="gone" />

        <!-- GERBANG PEMINDAIAN KEAMANAN -->
        <LinearLayout
            android:id="@+id/layoutSecurityWarning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">


        <ProgressBar
            android:id="@+id/pbScanning"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="100dp"
            android:indeterminate="true"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/ivSecurityAlert"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="80dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSecurityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memindai Keamanan..."
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvSecurityHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mohon tunggu sebentar, kami sedang memastikan perangkat Anda aman untuk ujian."
            android:textColor="#666666"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Area List Pelanggaran -->
        <ScrollView
            android:id="@+id/svViolations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSecurityDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp"
                android:textStyle="bold" />
        </ScrollView>

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BUKA PENGATURAN"
            android:backgroundTint="#0C4A6E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStartExam"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="MASUK HALAMAN UJIAN"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

    </LinearLayout>

    </FrameLayout>

</LinearLayout>
