<?xml version="1.0" encoding="utf-8"?>
<!-- custom_keyboard.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#222222"
    android:padding="6dp">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            style="@style/KeyboardButton"
            android:text="A" />
        <Button
            style="@style/KeyboardButton"
            android:text="B" />
        <Button
            style="@style/KeyboardButton"
            android:text="C" />
        <Button
            style="@style/KeyboardButton"
            android:text="D" />
        <Button
            style="@style/KeyboardButton"
            android:text="E" />
        <Button
            style="@style/KeyboardButton"
            android:text="F" />
        <Button
            style="@style/KeyboardButton"
            android:text="G" />
        <Button
            style="@style/KeyboardButton"
            android:text="H" />
        <Button
            style="@style/KeyboardButton"
            android:text="I" />
        <Button
            style="@style/KeyboardButton"
            android:text="J" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            style="@style/KeyboardButton"
            android:text="K" />
        <Button
            style="@style/KeyboardButton"
            android:text="L" />
        <Button
            style="@style/KeyboardButton"
            android:text="M" />
        <Button
            style="@style/KeyboardButton"
            android:text="N" />
        <Button
            style="@style/KeyboardButton"
            android:text="O" />
        <Button
            style="@style/KeyboardButton"
            android:text="P" />
        <Button
            style="@style/KeyboardButton"
            android:text="Q" />
        <Button
            style="@style/KeyboardButton"
            android:text="R" />
        <Button
            style="@style/KeyboardButton"
            android:text="S" />
        <Button
            style="@style/KeyboardButton"
            android:text="T" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            style="@style/KeyboardButton"
            android:text="U" />
        <Button
            style="@style/KeyboardButton"
            android:text="V" />
        <Button
            style="@style/KeyboardButton"
            android:text="W" />
        <Button
            style="@style/KeyboardButton"
            android:text="X" />
        <Button
            style="@style/KeyboardButton"
            android:text="Y" />
        <Button
            style="@style/KeyboardButton"
            android:text="Z" />
        <Button
            style="@style/KeyboardButton"
            android:text="0" />
        <Button
            style="@style/KeyboardButton"
            android:text="1" />
        <Button
            style="@style/KeyboardButton"
            android:text="2" />
        <Button
            style="@style/KeyboardButton"
            android:text="3" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            style="@style/KeyboardButton"
            android:text="4" />
        <Button
            style="@style/KeyboardButton"
            android:text="5" />
        <Button
            style="@style/KeyboardButton"
            android:text="6" />
        <Button
            style="@style/KeyboardButton"
            android:text="7" />
        <Button
            style="@style/KeyboardButton"
            android:text="8" />
        <Button
            style="@style/KeyboardButton"
            android:text="9" />
        <Button
            style="@style/KeyboardButton"
            android:text="⌫" />
        <Button
            style="@style/KeyboardButton"
            android:text="Spasi"
            android:layout_width="0dp"
            android:layout_weight="1" />
        <Button
            style="@style/KeyboardButton"
            android:text="Enter" />
    </LinearLayout>
</LinearLayout>
