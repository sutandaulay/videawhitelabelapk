<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 📸 Gambar dari kamera -->
    <external-files-path
        name="my_images"
        path="Pictures/" />

    <!-- 📂 File download dari WebView -->
    <external-files-path
        name="downloads"
        path="Download/" />

    <!-- 📁 Dokumen umum (PDF, Word, Excel, dll) -->
    <external-files-path
        name="documents"
        path="Documents/" />

    <!-- 🧠 Fallback umum agar tidak error pada Android 10–14 -->
    <cache-path
        name="cache"
        path="." />
</paths>